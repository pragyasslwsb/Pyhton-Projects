responses = build_responses()


def get_reply(user_input):
    normalized = user_input.strip().lower()
    return responses.get(normalized, "I'm not sure how to answer that. Please ask another question.")


def save_chat_history(history, file_name="chat_history.docx"):
    doc = Document()
    for user_text, bot_text in history:
        doc.add_paragraph(f"You: {user_text}")
        doc.add_paragraph(f"Bot: {bot_text}")
        doc.add_paragraph()

    file_path = os.path.join(os.getcwd(), file_name)
    doc.save(file_path)
    return file_path


chat_history = []

while True:
    try:
        user_input = input("You: ").strip()
    except EOFError:
        print("\nSession ended. Saving chat history...")
        file_path = save_chat_history(chat_history)
        print(f"All chat replies have been saved to a Word file: {file_path}")
        break

    if user_input.lower() in {"exit", "quit", "bye"}:
        final_reply = "Goodbye! Have a great day!"
        chat_history.append((user_input, final_reply))
        file_path = save_chat_history(chat_history)
        print(f"Bot: {final_reply}")
        print(f"All chat replies have been saved to a Word file: {file_path}")
        break

    reply = get_reply(user_input)
    chat_history.append((user_input, reply))
    print(f"Bot: {reply}")
